PORT=3000

# ---- PostgreSQL ----
# Set this to your Postgres connection string to use a real database.
# Examples:
#   Neon:     postgres://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
#   Supabase: postgres://postgres:pass@db.xxx.supabase.co:5432/postgres
#   Local:    postgres://postgres:postgres@localhost:5432/leaddesk
DATABASE_URL=

# If your Postgres does NOT use SSL (e.g. local dev), set:
# PGSSL=disable

# ---- Admin credentials ----
# The first admin user is created from these on startup.
# Change them for production. Password is stored scrypt-hashed, never plaintext.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password

# Set to "production" on your host so session cookies are marked Secure.
NODE_ENV=development

# ---- Offline demo mode ----
# With no DATABASE_URL set, the app automatically uses an in-memory
# Postgres (pg-mem) so it runs with zero setup. To force it explicitly:
# DB_DRIVER=mem
